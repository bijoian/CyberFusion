# Browser-facing API path. Keep this relative when using the Vite proxy or a
# production reverse proxy so the Control API remains same-origin.
VITE_API_BASE_URL=/api/v1

# Development/preview only: Vite forwards /api requests to the local Go API.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# Explicitly opt in to labeled local fixture data. Never enable in production.
VITE_DEMO_MODE=false
